# TableOS environment. Copy to .env and fill in. Local values come from `npx supabase status -o env`.
# Variables marked (API only) must never reach a browser.
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# openssl rand -hex 32
QR_SIGNING_SECRET=
# openssl rand -hex 32
SESSION_JWT_SECRET=
# openssl rand -base64 32  (AES-256-GCM key)
CREDENTIALS_ENCRYPTION_KEY=
AI_SERVICE_URL=http://127.0.0.1:8000
# openssl rand -hex 32
AI_SERVICE_TOKEN=
# Anthropic API key for the AI service
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
# razorpay | stripe | mock (mock is development only)
PLATFORM_PG_PROVIDER=mock
PLATFORM_PG_KEY_ID=
PLATFORM_PG_KEY_SECRET=
PLATFORM_PG_WEBHOOK_SECRET=
EMAIL_API_KEY=
EMAIL_FROM=TableOS <no-reply@tableos.in>
SMTP_URL=smtp://127.0.0.1:54325
SENTRY_DSN=
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CONSOLE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MENU_URL=http://localhost:3000
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# openssl rand -hex 24
REVALIDATE_SECRET=
# Seed only: real inboxes for the demo owner / platform admin on hosted environments
SEED_OWNER_EMAIL=
SEED_ADMIN_EMAIL=
